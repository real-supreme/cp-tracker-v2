# ---- Supercell API ----
# Comma-separated list of JWT keys from https://developer.clashofclans.com
# At least one is required. The rate limit is 30 requests/second per key.
COC_API_KEYS=

# ---- Database ----
# CockroachDB Cloud (production):
#   postgresql+asyncpg://<user>:<pass>@<host>:26257/<db>?sslmode=require
# CockroachDB OSS / Postgres (local / dev):
#   postgresql+asyncpg://root@localhost:26257/defaultdb?sslmode=disable
# This URL is the single source of truth for which backend is used.
DATABASE_URL=

# ---- API client auth ----
# Comma-separated list of client tokens, format: name:secret,name2:secret2
# The name is logged; the secret is only compared. Keep these secret.
API_CLIENT_KEYS=

# ---- Email alerts (optional) ----
# If SMTP_HOST is set, 429 alerts and recovery notices are emailed. If unset, log-only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

# ---- Runtime ----
LOG_LEVEL=INFO
CONFIG_PATH=/app/config/config.yaml